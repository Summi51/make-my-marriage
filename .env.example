# MongoDB connection string. Required once database-backed features begin.
MONGODB_URI=

# Public application origin. Required for authentication mutations in production.
# Local development defaults to the request origin.
APP_ORIGIN=http://localhost:3000

# Later integrations; leave unset until their milestones begin.
# RESEND_API_KEY=
# EMAIL_FROM=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# GOOGLE_PLACES_API_KEY=
