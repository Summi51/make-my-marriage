# MongoDB connection string. Required once database-backed features begin.
MONGODB_URI=

# Public application origin. Required for authentication mutations in production.
# Use your public HTTPS URL in production so invitation links work outside localhost.
# Local development defaults to the request origin.
APP_ORIGIN=http://localhost:3000

# Optional. Origin used when building guest invitation links. Falls back to
# APP_ORIGIN, then to a relative link, so most deployments only need APP_ORIGIN.
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Member invitations. Use a random secret of at least 32 characters.
MEMBER_INVITATION_SECRET=

# Daily reminder job. Use a different random secret of at least 32 characters.
# Call POST /api/internal/jobs/reminders once a day with
# Authorization: Bearer <CRON_SECRET>. The route sends due emails and prepares
# WhatsApp reminders for members to open. It does not send WhatsApp itself.
CRON_SECRET=
VOLANEA_API_KEY=
# For production, use a sender on a domain you control and verify in Volanea
# with its required SPF, DKIM, and DMARC DNS records.
VOLANEA_FROM="Make My Marriage <invites@your-verified-domain.com>"

# Private Cloudflare R2 bucket for member photo uploads. Leave unset until
# gallery storage is configured. Do not set a public bucket URL.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# GOOGLE_PLACES_API_KEY=
